@page
@model TeddysModel
@using System.IO
@functions {
    string FormatDisplayName(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return string.Join(" ", value
            .Replace("_", " ")
            .Replace("-", " ")
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(word => char.ToUpperInvariant(word[0]) + word.Substring(1)));
    }
}
@{
    ViewData["Title"] = "Teddys";
    var firstTeddy = Model.TeddyImages.FirstOrDefault() ?? string.Empty;
    var firstBackground = Model.BackgroundImages.FirstOrDefault() ?? string.Empty;
    var firstTeddyName = !string.IsNullOrEmpty(firstTeddy) ? FormatDisplayName(System.IO.Path.GetFileNameWithoutExtension(firstTeddy)) : "No teddy";
}

<div class="teddy-studio-page">
    <section class="panel studio-panel">
        <div class="panel-header">
            <h2></h2>
        </div>

        <div class="studio-layout">
            <aside class="studio-sidebar">
                <div class="studio-section">
                    <h3>Teddys</h3>
                    <div class="thumb-grid">
                        @foreach (var teddy in Model.TeddyImages)
                        {
                            var name = FormatDisplayName(System.IO.Path.GetFileNameWithoutExtension(teddy));
                            var isActive = teddy == firstTeddy;
                            <button type="button"
                                    class="thumb-card teddy-thumb @(isActive ? "active" : "")"
                                    data-image="@teddy"
                                    data-name="@name"
                                    draggable="true"
                                    title="Drag onto the stage">
                                <img src="@teddy" alt="@name" />
                                <span>@name</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="studio-section">
                    <h3>Backgrounds</h3>
                    <div class="thumb-grid">
                        @foreach (var background in Model.BackgroundImages)
                        {
                            var name = FormatDisplayName(System.IO.Path.GetFileNameWithoutExtension(background));
                            var isActive = background == firstBackground;
                            <button type="button"
                                    class="thumb-card bg-thumb @(isActive ? "active" : "")"
                                    data-image="@background"
                                    data-name="@name">
                                <img src="@background" alt="@name" />
                                <span>@name</span>
                            </button>
                        }
                    </div>
                </div>

            </aside>

            <div class="studio-main">
                <div class="preview-stage" id="previewStage">
                    <img id="previewBackground" class="preview-background" src="@firstBackground" alt="Background preview" />
                    <div id="teddyLayer" class="teddy-layer"></div>
                </div>

                <div class="studio-controls">
                    <div>
                        <h3>Selected teddy</h3>
                        <p id="selectedTeddyName">@firstTeddyName</p>
                    </div>

                    <label class="control-group">
                        <span>Size</span>
                        <input type="range" id="scaleRange" min="0.5" max="2.5" step="0.05" value="1" />
                        <strong id="scaleValue">100%</strong>
                    </label>

                    <label class="control-group">
                        <span>Rotation</span>
                        <input type="range" id="rotationRange" min="-180" max="180" step="1" value="0" />
                        <strong id="rotationValue">0°</strong>
                    </label>

                    <div class="control-row">
                        <button type="button" id="removeSelectedBtn" class="hero-button secondary">Remove</button>
                        <button type="button" id="resetPreviewBtn" class="hero-button secondary">Reset</button>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        const teddyButtons = Array.from(document.querySelectorAll('.teddy-thumb'));
        const backgroundButtons = Array.from(document.querySelectorAll('.bg-thumb'));
        const previewStage = document.getElementById('previewStage');
        const teddyLayer = document.getElementById('teddyLayer');
        const previewBackground = document.getElementById('previewBackground');
        const selectedTeddyName = document.getElementById('selectedTeddyName');
        const scaleRange = document.getElementById('scaleRange');
        const rotationRange = document.getElementById('rotationRange');
        const scaleValue = document.getElementById('scaleValue');
        const rotationValue = document.getElementById('rotationValue');
        const addTeddyBtn = document.getElementById('addTeddyBtn');
        const removeSelectedBtn = document.getElementById('removeSelectedBtn');
        const resetPreviewBtn = document.getElementById('resetPreviewBtn');

        let selectedTeddyImage = document.querySelector('.teddy-thumb.active')?.dataset.image || teddyButtons[0]?.dataset.image || '';
        let selectedBackgroundImage = document.querySelector('.bg-thumb.active')?.dataset.image || backgroundButtons[0]?.dataset.image || '';
        let sceneItems = [];
        let selectedItemId = null;
        let dragState = null;

        function setActiveButton(buttons, activeButton) {
            buttons.forEach(button => button.classList.toggle('active', button === activeButton));
        }

        function updateSelectionState() {
            const selectedItem = sceneItems.find(item => item.id === selectedItemId);
            if (!selectedItem) {
                selectedTeddyName.textContent = 'No teddy selected';
                scaleRange.disabled = true;
                rotationRange.disabled = true;
                scaleValue.textContent = '100%';
                rotationValue.textContent = '0°';
                return;
            }

            selectedTeddyName.textContent = selectedItem.name;
            scaleRange.disabled = false;
            rotationRange.disabled = false;
            scaleRange.value = selectedItem.scale;
            rotationRange.value = selectedItem.rotation;
            scaleValue.textContent = `${Math.round(selectedItem.scale * 100)}%`;
            rotationValue.textContent = `${selectedItem.rotation}°`;
        }

        function renderScene() {
            teddyLayer.innerHTML = '';
            sceneItems.forEach(item => {
                const node = document.createElement('button');
                node.type = 'button';
                node.className = `scene-item${item.id === selectedItemId ? ' selected' : ''}`;
                node.dataset.id = item.id;
                node.style.left = `${item.x}%`;
                node.style.top = `${item.y}%`;
                node.style.transform = `translate(-50%, -50%) rotate(${item.rotation}deg) scale(${item.scale})`;

                const image = document.createElement('img');
                image.src = item.image;
                image.alt = item.name;
                image.draggable = false;
                node.appendChild(image);

                node.addEventListener('pointerdown', (event) => {
                    event.stopPropagation();
                    selectSceneItem(item.id);
                    dragState = { id: item.id, startX: event.clientX, startY: event.clientY, startItemX: item.x, startItemY: item.y };
                    document.body.classList.add('dragging');
                });

                teddyLayer.appendChild(node);
            });

            updateSelectionState();
        }

        function selectSceneItem(id) {
            selectedItemId = id;
            renderScene();
        }

        function addSelectedTeddyToScene(position = { x: 50, y: 50 }) {
            if (!selectedTeddyImage) {
                return;
            }

            const selectedButton = teddyButtons.find(button => button.dataset.image === selectedTeddyImage);
            const name = selectedButton?.dataset.name || 'Teddy';
            const item = {
                id: Date.now(),
                name,
                image: selectedTeddyImage,
                x: position.x,
                y: position.y,
                scale: 1,
                rotation: 0
            };
            sceneItems.push(item);
            selectedItemId = item.id;
            renderScene();
        }

        function removeSelectedTeddy() {
            if (!selectedItemId) {
                return;
            }
            sceneItems = sceneItems.filter(item => item.id !== selectedItemId);
            selectedItemId = sceneItems[0]?.id || null;
            renderScene();
        }

        function updatePreviewBackground() {
            previewBackground.src = selectedBackgroundImage;
        }

        teddyButtons.forEach(button => {
            button.addEventListener('click', () => {
                selectedTeddyImage = button.dataset.image;
                setActiveButton(teddyButtons, button);
            });

            button.addEventListener('dragstart', (event) => {
                const image = button.dataset.image;
                if (!image) {
                    event.preventDefault();
                    return;
                }

                selectedTeddyImage = image;
                setActiveButton(teddyButtons, button);
                event.dataTransfer?.setData('application/teddy-image', image);
                event.dataTransfer?.setData('text/plain', image);
                event.dataTransfer.effectAllowed = 'copy';
            });
        });

        backgroundButtons.forEach(button => {
            button.addEventListener('click', () => {
                selectedBackgroundImage = button.dataset.image;
                setActiveButton(backgroundButtons, button);
                updatePreviewBackground();
            });
        });

        removeSelectedBtn.addEventListener('click', removeSelectedTeddy);

        scaleRange.addEventListener('input', () => {
            const selectedItem = sceneItems.find(item => item.id === selectedItemId);
            if (!selectedItem) {
                return;
            }
            selectedItem.scale = parseFloat(scaleRange.value);
            scaleValue.textContent = `${Math.round(selectedItem.scale * 100)}%`;
            renderScene();
        });

        rotationRange.addEventListener('input', () => {
            const selectedItem = sceneItems.find(item => item.id === selectedItemId);
            if (!selectedItem) {
                return;
            }
            selectedItem.rotation = parseInt(rotationRange.value, 10);
            rotationValue.textContent = `${selectedItem.rotation}°`;
            renderScene();
        });

        resetPreviewBtn.addEventListener('click', () => {
            // Remove ALL teddys currently on the stage (same effect as Remove, but for every teddy).
            sceneItems.length = 0;
            selectedItemId = null;

            // Hard clear the layer immediately.
            teddyLayer.innerHTML = '';

            // Also clear any scene-item nodes that might have been (re)inserted.
            // (If the UI flickers, something is recreating nodes; this removes them on the spot.)
            Array.from(teddyLayer.querySelectorAll('.scene-item')).forEach(n => n.remove());

            // Ensure controls state/UI matches an empty scene.
            updateSelectionState();
            scaleRange.disabled = true;
            rotationRange.disabled = true;
        });



        previewStage.addEventListener('dragover', (event) => {
            if (event.dataTransfer?.types?.includes('application/teddy-image') || event.dataTransfer?.types?.includes('text/plain')) {
                event.preventDefault();
                event.dataTransfer.dropEffect = 'copy';
            }
        });

        previewStage.addEventListener('drop', (event) => {
            event.preventDefault();
            const image = event.dataTransfer?.getData('application/teddy-image') || event.dataTransfer?.getData('text/plain');
            if (image) {
                selectedTeddyImage = image;
                const button = teddyButtons.find(item => item.dataset.image === image);
                if (button) {
                    setActiveButton(teddyButtons, button);
                }
            }

            const rect = previewStage.getBoundingClientRect();
            const x = ((event.clientX - rect.left) / rect.width) * 100;
            const y = ((event.clientY - rect.top) / rect.height) * 100;
            addSelectedTeddyToScene({ x: Math.max(8, Math.min(92, x)), y: Math.max(8, Math.min(92, y)) });
        });

        previewStage.addEventListener('pointerdown', (event) => {
            if (event.target === previewStage || event.target === previewBackground || event.target === teddyLayer) {
                selectedItemId = null;
                renderScene();
            }
        });

        document.addEventListener('pointermove', (event) => {
            if (!dragState) {
                return;
            }
            const rect = previewStage.getBoundingClientRect();
            const item = sceneItems.find(sceneItem => sceneItem.id === dragState.id);
            if (!item) {
                return;
            }
            const x = ((event.clientX - rect.left) / rect.width) * 100;
            const y = ((event.clientY - rect.top) / rect.height) * 100;
            item.x = Math.max(8, Math.min(92, x));
            item.y = Math.max(8, Math.min(92, y));
            renderScene();
        });

        document.addEventListener('pointerup', () => {
            if (dragState) {
                dragState = null;
                document.body.classList.remove('dragging');
            }
        });

        updatePreviewBackground();
        renderScene();
    </script>
}
